# ==============================================================================
# Muzaffarnagar Kaamgar — Environment Configuration Template
# ==============================================================================

# --- 1. Frontend Client Configuration (Vercel / Netlify / Production Host) ---
# Supabase Project URL & Anon/Publishable API Key (Safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# MSG91 OTP Widget Configuration (For real phone number SMS OTP verification)
VITE_MSG91_WIDGET_ID=your-msg91-widget-id
VITE_MSG91_TOKEN_AUTH=your-msg91-token-auth


# --- 2. Supabase Edge Functions Secrets (Set in Supabase Dashboard / CLI) ---
# NEVER expose these in frontend code or Git! Set them via:
# supabase secrets set GROQ_API_KEY=... MSG91_AUTH_KEY=...
#
# GROQ_API_KEY=your-groq-cloud-api-key
# MSG91_AUTH_KEY=your-msg91-authkey
# MSG91_FLOW_BOOKING_CREATED=your-msg91-flow-template-id-1
# MSG91_FLOW_BOOKING_ACCEPTED=your-msg91-flow-template-id-2
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key